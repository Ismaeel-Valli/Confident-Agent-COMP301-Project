{
  "name": "confident-agent-toolbox",
  "version": "3.0.0",
  "description": "Confident Agent Toolbox (COMP301): static verification of REST API claims in LLM-generated Python code. LM Studio tools provider plus an external controller CLI.",
  "main": "dist/index.js",
  "scripts": {
    "dev": "lms dev",
    "push": "lms push",
    "typecheck": "node scripts/embed-python.cjs && tsc --noEmit",
    "build": "node scripts/embed-python.cjs && tsc && node scripts/build-plugin.cjs",
    "test": "node --test tests/*.test.js",
    "ci": "npm run build && npm test",
    "verify": "node dist/verificationCli.js",
    "verify:references": "node scripts/verify-reference-solutions.cjs",
    "evaluate:pilot": "node scripts/evaluate-pilot.cjs"
  },
  "author": "The Skeptics (UKZN COMP301)",
  "license": "MIT",
  "dependencies": {
    "@lmstudio/sdk": "1.4.0",
    "pyright": "1.1.414",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.8",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
