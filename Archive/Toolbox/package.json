{
  "name": "confidence-agent-toolbox",
  "version": "1.6.0",
  "description": "Confidence Agent toolbox with conservative contract verification and a mandatory six-layer controller.",
  "main": "index.js",
  "scripts": {
    "dev": "lms dev",
    "push": "lms push",
    "typecheck": "node scripts/embed-python.cjs && tsc --noEmit",
    "build": "node scripts/embed-python.cjs && tsc && node scripts/build-plugin.cjs",
    "test": "node --test tests/*.test.js",
    "ci": "npm run typecheck && npm run build && npm run test",
    "test:verification": "node --test tests/verification.test.js",
    "verify": "node dist/verificationCli.js",
    "evaluate:pilot": "node scripts/evaluate-pilot.cjs",
    "verify:references": "node scripts/verify-reference-solutions.cjs"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@lmstudio/sdk": "1.4.0",
    "better-sqlite3": "^12.4.6",
    "duck-duck-scrape": "^2.2.7",
    "html-to-text": "^9.0.5",
    "mammoth": "^1.11.0",
    "node-notifier": "^10.0.1",
    "open": "^11.0.0",
    "pdf-parse": "^2.4.5",
    "puppeteer": "^24.31.0",
    "pyright": "1.1.414",
    "simple-git": "^3.30.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^20.14.8",
    "@types/node-notifier": "^8.0.5",
    "@types/pdf-parse": "^1.1.5",
    "esbuild": "0.28.2",
    "ts-morph": "^27.0.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
